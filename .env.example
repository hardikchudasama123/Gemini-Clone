# --- Groq (chat models — the default) -------------------------------------
# Get a key from https://console.groq.com/keys
# This is the only key the app really needs.
GROQ_API_KEY=your_key_here

# --- Cloudflare Workers AI (text-to-image) --------------------------------
# Generates images on the free allocation. Gemini's image models have a
# free-tier quota of 0, so without billing there this is what actually draws.
# Account ID: https://dash.cloudflare.com -> Workers & Pages (right sidebar)
# Token:      My Profile -> API Tokens, with the "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Gemini (optional) ----------------------------------------------------
# Needed for pdf / audio / video input, which no other provider here accepts.
# Its Nano Banana image models also need billing enabled on the key.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Supabase (Google sign-in + synced chat history) ----------------------
# Project Settings -> Data API / API Keys.
# Both values are browser-safe: the anon key is protected by RLS, not secrecy.
# Never put the service_role / secret key here — this app does not use one.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key

# --- Server ---------------------------------------------------------------
# Port for the API and the built UI
PORT=8787
